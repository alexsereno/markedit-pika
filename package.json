{
  "name": "markedit-pika",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Complete Pika Micropub publishing for MarkEdit.",
  "license": "MIT",
  "author": "alexsereno",
  "scripts": {
    "build": "bun scripts/build.ts",
    "lint": "biome check src tests scripts/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun test && bun run build",
    "test:webkit": "bun scripts/smoke.ts",
    "install:markedit": "bun run check && bun scripts/install.ts"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.1",
    "@types/bun": "1.3.1",
    "@types/mdast": "4.0.4",
    "esbuild": "0.25.11",
    "markedit-api": "https://github.com/MarkEdit-app/MarkEdit-api#v0.38.0",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexsereno/markedit-pika.git"
  },
  "homepage": "https://github.com/alexsereno/markedit-pika"
}
